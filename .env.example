# Copy to .env and fill in. None of these are required to run the analysis pipeline.

# Absolute path to your music library. AutoDJ only ever reads from here.
MUSIC_DIR=/path/to/your/music

# Where the SQLite cache, stems and rendered mixes go.
DATA_DIR=./data

# Trend providers (all optional - missing keys just disable that provider)
LASTFM_API_KEY=
YOUTUBE_API_KEY=
# Apple Music charts use the public RSS feed and need no key.

# Server
HOST=127.0.0.1
PORT=8000
