# Copy to .env and fill in. None of these are required to run the analysis pipeline.

# Absolute path to your music library. AutoDJ only ever reads from here.
MUSIC_DIR=/path/to/your/music

# DJ sets for AutoDJ to learn transition style from. Keep these OUT of
# MUSIC_DIR: a full-length set left there is scanned as a track and can end up
# inside a mix.
REFERENCE_DIR=./reference

# Where the SQLite cache, stems and rendered mixes go.
DATA_DIR=./data

# Trend providers (all optional - missing keys just disable that provider)
LASTFM_API_KEY=
YOUTUBE_API_KEY=
# Apple Music charts use the public RSS feed and need no key.

# Server. 127.0.0.1 = this computer only.
# Set HOST=0.0.0.0 to reach AutoDJ from your phone on the same Wi-Fi.
# There is no login, so only do that on a network you trust.
HOST=127.0.0.1
PORT=8000
